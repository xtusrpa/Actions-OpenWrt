CONFIG_PACKAGE_libstdcpp=y                                     # C++ 标准库（许多现代程序依赖）
CONFIG_PACKAGE_libxtables=y                                    # iptables/xtables 的共享动态链接库
CONFIG_PACKAGE_libyaml=y                                       # YAML 格式解析库
CONFIG_PACKAGE_lsblk=y                                         # 列出系统块设备（磁盘/分区）信息的工具
CONFIG_PACKAGE_luci-app-adblock-fast=y                         # 快速广告拦截插件
CONFIG_PACKAGE_luci-app-advanced-reboot=y                      # 高级重启插件（支持重启到特定分区或关机）
CONFIG_PACKAGE_luci-app-argon-config=y                         # Argon 主题的自定义配置界面
CONFIG_PACKAGE_luci-app-autoreboot=y                           # 路由器定时自动重启插件
CONFIG_PACKAGE_luci-app-cifs-mount=y                           # SMB/CIFS 网络共享目录挂载插件
CONFIG_PACKAGE_luci-app-diskman=y                              # 磁盘及分区管理插件
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y          # 磁盘管理：包含 Btrfs 文件系统管理工具
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y                # 磁盘管理：包含 lsblk 依赖
CONFIG_PACKAGE_luci-app-homeproxy=y                            # HomeProxy 代理客户端（基于 Sing-box）
CONFIG_PACKAGE_luci-app-mosdns=y                               # MosDNS 的网页控制面板（有界面的插件）
CONFIG_PACKAGE_luci-app-openclash=y                            # OpenClash 代理客户端插件
CONFIG_PACKAGE_luci-app-qos=y                                  # QoS (服务质量) 流量限速与带宽分配插件
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client is not set # 未启用：SSR-Plus 组件
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y                  # 解锁网易云音乐灰色版权歌曲插件
CONFIG_PACKAGE_luci-app-upnp=y                                 # UPnP 自动端口映射插件
CONFIG_PACKAGE_luci-app-vlmcsd=y                               # KMS 激活服务器的网页控制面板（有界面的插件）
CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn=y                  # 广告拦截插件 - 中文语言包
CONFIG_PACKAGE_luci-i18n-advanced-reboot-zh-cn=y               # 高级重启插件 - 中文语言包
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y                  # Argon 主题配置 - 中文语言包
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y                    # 定时重启插件 - 中文语言包
CONFIG_PACKAGE_luci-i18n-cifs-mount-zh-cn=y                    # 网络共享挂载插件 - 中文语言包
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y                       # 磁盘管理插件 - 中文语言包
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y                     # HomeProxy - 中文语言包
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y                        # MosDNS - 中文语言包
CONFIG_PACKAGE_luci-i18n-qos-zh-cn=y                           # QoS 插件 - 中文语言包
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y                          # UPnP 插件 - 中文语言包
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y                        # KMS 激活插件 - 中文语言包
CONFIG_PACKAGE_luci-theme-argon=y                              # Argon 路由器后台管理主题
CONFIG_PACKAGE_luci-theme-openwrt-2020=y                       # OpenWrt 2020 默认后台管理主题
CONFIG_PACKAGE_miniupnpd-nftables=y                            # 基于 nftables (新一代防火墙) 的 UPnP 守护进程
CONFIG_PACKAGE_mosdns=y                                        # MosDNS 核心程序（底层依赖，必须有）
CONFIG_PACKAGE_node=y                                          # Node.js 运行环境（解锁网易云音乐等依赖）
CONFIG_PACKAGE_parted=y                                        # 强大的磁盘分区命令行管理工具
CONFIG_PACKAGE_qos-scripts=y                                   # QoS 流量控制底层执行脚本
CONFIG_PACKAGE_r8169-firmware=y                                # Realtek r8169 系列网卡的官方固件驱动
CONFIG_PACKAGE_resolveip=y                                     # 轻量级的域名 IP 解析工具
CONFIG_PACKAGE_ruby=y                                          # Ruby 解释器（某些脚本或应用的依赖）
CONFIG_PACKAGE_ruby-bigdecimal=y                               # Ruby 库：高精度浮点数计算
CONFIG_PACKAGE_ruby-date=y                                     # Ruby 库：日期与时间处理
CONFIG_PACKAGE_ruby-digest=y                                   # Ruby 库：加密与哈希摘要计算
CONFIG_PACKAGE_ruby-enc=y                                      # Ruby 库：字符编码支持
CONFIG_PACKAGE_ruby-pstore=y                                   # Ruby 库：基于文件的对象本地存储
CONFIG_PACKAGE_ruby-psych=y                                    # Ruby 库：YAML 解析与生成
CONFIG_PACKAGE_ruby-stringio=y                                 # Ruby 库：字符串内存 I/O 操作
CONFIG_PACKAGE_ruby-yaml=y                                     # Ruby 库：YAML 数据支持封装
CONFIG_PACKAGE_sing-box=y                                      # Sing-box 代理核心程序（HomeProxy 的底层核心）
CONFIG_PACKAGE_smartmontools=y                                 # 硬盘 S.M.A.R.T. 健康状态检测工具
CONFIG_PACKAGE_tc-tiny=y                                       # 精简版的 Linux 流量控制工具
CONFIG_PACKAGE_ucode-mod-digest=y                              # ucode 脚本语言的哈希摘要模块
CONFIG_PACKAGE_ucode-mod-uloop=y                               # ucode 脚本语言的事件循环模块
CONFIG_PACKAGE_unzip=y                                         # ZIP 压缩包解压工具
CONFIG_PACKAGE_vlmcsd=y                                        # 兼容微软 KMS 激活的本地服务端核心程序（底层依赖）
CONFIG_PACKAGE_xtables-nft=y                                   # 提供 iptables 语法到 nftables 后端的兼容转换层
CONFIG_PACKAGE_zlib=y                                          # Zlib 数据压缩核心库
CONFIG_PARTED_READLINE=y                                       # 启用 parted 磁盘工具的 Readline 支持
CONFIG_RUBY_ENABLE_YJIT=y                                      # 启用 Ruby 的 YJIT 即时编译器以提升运行性能
CONFIG_TARGET_KERNEL_PARTSIZE=532                              # 分配系统内核 (Kernel) 分区大小为 532 MB
CONFIG_TARGET_ROOTFS_PARTSIZE=1660                             # 分配系统根文件系统 (Rootfs) 分区大小为 1660 MB
