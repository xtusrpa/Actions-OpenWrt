# --- 移除 DDNS-GO ---
# CONFIG_PACKAGE_ddns-go is not set
# CONFIG_PACKAGE_luci-app-ddns-go is not set
# CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn is not set

# --- 添加 udpxy (用于组播转单播) ---
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y

# --- 添加 MosDNS ---
# CONFIG_PACKAGE_mosdns=y
# CONFIG_PACKAGE_luci-app-mosdns=y
# CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=y
# CONFIG_PACKAGE_v2ray-geodata=y

# --- 添加 AdGuard Home ---
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# --- 启用官方动态 DNS 及腾讯云/DNSPod支持 ---
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_tencent=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y

# --- 添加 APP上网管理 ---
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-app-appfilter=y
CONFIG_PACKAGE_luci-i18n-appfilter-zh-cn=y
